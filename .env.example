LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form (server-side email via Resend). These are read ONLY on the
# server, so the recipient address is never shipped to the browser or scrapable.
# RESEND_API_KEY: create a free key at https://resend.com
# CONTACT_EMAIL: where contact-form messages are delivered (your inbox).
# CONTACT_FROM_EMAIL: optional; defaults to Resend's shared onboarding sender
#   ("Portfolio Contact <onboarding@resend.dev>") until you verify your own domain.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=

# Optional future local provider configuration. Ollama is not currently enabled.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
